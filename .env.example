# قاعدة البيانات: SQLite للتجربة، PostgreSQL للإنتاج
DATABASE_URL=sqlite:///./fde.db
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/fde

# وضع التطوير (مستخدمو تجربة عبر X-User) — اجعله false في الإنتاج
DEV_MODE=true

# واتساب Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=

# موصل ERP: export (آمن) | odoo (لاحقاً)
ERP_CONNECTOR=export

# سياسات الأعمال — اضبطها قبل الإنتاج ولا يخترعها النظام
# APPROVAL_THRESHOLD_1=
# APPROVAL_THRESHOLD_2=
PRICE_TOLERANCE_PCT=0.0
MIN_QUOTATIONS=2

# سر مشترك لتأكيدات ترحيل ERP (Webhook) — إلزامي في الإنتاج
ERP_WEBHOOK_SECRET=

# سياسات التكلفة (المرحلة 3)
# DEFAULT_LABOR_RATE=35.0
# OVERHEAD_PCT=5.0
